<?xml version="1.0" encoding="utf-8"?>
<!-- v1.15 (fiche R3) : rien ne part en sauvegarde cloud ni en transfert d'appareil à appareil
     (la configuration contient le jeton Home Assistant ; la clé Keystore ne serait de toute façon pas copiée). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Seule l'appli Adria (même signature) peut envoyer des messages à lire dans la voiture -->
    <permission
        android:name="fr.kerherve.jarvis.BRIDGE"
        android:protectionLevel="signature" />

    <application android:label="Adria Messages">

        <activity
            android:name=".MessagesActivity"
            android:exported="true"
            android:label="Adria Messages">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".BridgeReceiver"
            android:exported="true"
            android:permission="fr.kerherve.jarvis.BRIDGE">
            <intent-filter>
                <action android:name="fr.kerherve.jarvis.BRIDGE_MSG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
